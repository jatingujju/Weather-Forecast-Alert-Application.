# ---------------------------------------------------------------
# Copy this file to a new file named ".env" and fill in YOUR values.
#   Windows: copy .env.example .env      Mac/Linux: cp .env.example .env
# NEVER upload ".env" to GitHub. Only this example file is uploaded.
# ---------------------------------------------------------------

# Needed only for:  python main.py --mode api --provider openweathermap
# Get a free key at https://openweathermap.org/api (new keys can take a while to activate)
OPENWEATHER_API_KEY=your_openweathermap_key_here

# Optional email alerts:  python main.py --notify
# (Gmail needs an "app password", not your normal password.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password_here
ALERT_EMAIL_TO=receiver@example.com
